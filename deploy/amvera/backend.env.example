DATABASE_URL=postgres://USER:PASSWORD@POSTGRES_HOST:5432/DATABASE
REDIS_URL=redis://REDIS_HOST:6379
MEDUSA_BACKEND_URL=https://YOUR-BACKEND.amvera.tech
MEDUSA_ADMIN_ON=1
STORE_CORS=https://YOUR-SHOP.amvera.tech
ADMIN_CORS=https://YOUR-BACKEND.amvera.tech
AUTH_CORS=https://YOUR-SHOP.amvera.tech,https://YOUR-BACKEND.amvera.tech
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
COOKIE_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
# Optional runtime secrets: set both to create/update the administrator on startup.
# MEDUSA_ADMIN_EMAIL=admin@example.com
# MEDUSA_ADMIN_PASSWORD=REPLACE_WITH_PASSWORD_AT_LEAST_12_CHARACTERS
MOYSKLAD_API_TOKEN=
MOYSKLAD_ORGANIZATION_ID=
MOYSKLAD_STORE_ID=
MOYSKLAD_PRICE_TYPE_ID=
MOYSKLAD_WEBHOOK_SECRET=
MOYSKLAD_ALLOW_WRITES=false
# Час ночной пересборки поискового индекса (0–23). Синк каталога — час 3.
# MOYSKLAD_SEARCH_REINDEX_HOUR=5
